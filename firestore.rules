rules_version = '2';
// Правила доступа к базе. Вставить в Firebase → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // Прогресс: читать и писать может только сам ученик
    match /progress/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.json is string && request.resource.data.json.size() < 900000;
    }
    // Рейтинг: видят все вошедшие, пишет каждый только свою строку
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'xp', 'weekXp', 'week', 'streak', 'updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 20
        && request.resource.data.xp is int && request.resource.data.xp < 10000000;
    }
  }
}
